{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Frontend",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend"
        },
        {
            "type": "pwa-node",
            "request": "launch",
            "name": "Debug Backend",
            "cwd": "${workspaceFolder}/backend",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["tsx", "index.ts"],
            "sourceMaps": true,
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/backend/.env",
            "env":{"PORT":"5000"},
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ]
        }
    ],
    "compounds": [
        {
            "name": "Debug Full Stack",
            "configurations": [
                "Debug Backend",
                "Debug Frontend"
            ]
        }
    ]
}